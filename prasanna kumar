
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Diwali Festival</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Navigation Bar -->
    <header>
        <nav class="navbar">
            <h2>🪔 Diwali Festival</h2>
            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#celebrations">Celebrations</a></li>
                <li><a href="#decorations">Decorations</a></li>
                <li><a href="#safety">Safety Tips</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Home Section -->
    <section id="home" class="hero">
        <div class="hero-content">
            <h1>✨ Happy Diwali ✨</h1>
            <h2>Festival of Lights</h2>
            <p>May your life shine with happiness,
               prosperity and endless joy!</p>
            <a href="#about" class="btn">Explore Diwali</a>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="section">
        <h2>🪔 About Diwali</h2>
        <p>
            Diwali is one of the most popular festivals
            celebrated in India. It is known as the Festival
            of Lights. People celebrate Diwali by lighting
            diyas, decorating homes, sharing sweets and
            spending time with family.
        </p>

        <img src="https://images.unsplash.com/photo-1606293926075-69a00dbfde81?w=900"
             alt="Beautiful Diwali lights">
    </section>

    <!-- Celebrations Section -->
    <section id="celebrations" class="section">
        <h2>🎆 Diwali Celebrations</h2>

        <div class="cards">

            <div class="card">
                <img src="https://images.unsplash.com/photo-1605640840605-14ac1855827b?w=500"
                     alt="Diwali diyas">
                <h3>Lighting Diyas</h3>
                <p>People light beautiful diyas and candles.</p>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1577083552431-6e5fd01aa342?w=500"
                     alt="Rangoli decoration">
                <h3>Rangoli</h3>
                <p>Colourful rangoli designs decorate homes.</p>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1605197161470-5d6c7d4b5f2e?w=500"
                     alt="Indian sweets">
                <h3>Sharing Sweets</h3>
                <p>Families share delicious sweets and gifts.</p>
            </div>

        </div>
    </section>

    <!-- Decorations Section -->
    <section id="decorations" class="section">
        <h2>🌸 Decorations and Diyas</h2>

        <div class="gallery">
            <img src="https://images.unsplash.com/photo-1606293926075-69a00dbfde81?w=500"
                 alt="Diwali lamps">

            <img src="https://images.unsplash.com/photo-1577083552431-6e5fd01aa342?w=500"
                 alt="Rangoli">

            <img src="https://images.unsplash.com/photo-1605640840605-14ac1855827b?w=500"
                 alt="Festival decorations">
        </div>

        <p>Decorate your home with flowers, lights,
           candles, rangoli and beautiful diyas.</p>
    </section>

    <!-- Audio and Video Section -->
    <section class="section media">
        <h2>🎵 Diwali Music and Video</h2>

        <h3>Listen to Diwali Music</h3>

        <audio controls>
            <source src="media/diwali.mp3" type="audio/mpeg">
            Your browser does not support audio.
        </audio>

        <h3>Watch Diwali Celebration Video</h3>

        <video controls width="80%">
            <source src="media/diwali.mp4" type="video/mp4">
            Your browser does not support video.
        </video>
    </section>

    <!-- Safety Section -->
    <section id="safety" class="section safety">
        <h2>⚠️ Diwali Safety Tips</h2>

        <ul>
            <li>Always burst crackers in open spaces.</li>
            <li>Keep water and first-aid nearby.</li>
            <li>Wear cotton clothes while lighting diyas.</li>
            <li>Keep fireworks away from children.</li>
            <li>Avoid noisy and harmful firecrackers.</li>
            <li>Protect pets and the environment.</li>
        </ul>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="section contact">
        <h2>📩 Contact Us</h2>

        <form>
            <label>Your Name:</label>
            <input type="text" placeholder="Enter your name" required>

            <label>Email:</label>
            <input type="email" placeholder="Enter your email" required>

            <label>Message:</label>
            <textarea placeholder="Write your message"></textarea>

            <button type="submit">Send Message</button>
        </form>
    </section>

    <!-- Footer -->
    <footer>
        <h3>🪔 Happy Diwali 🪔</h3>
        <p>May this festival bring light and happiness
           into your life.</p>
        <p>© 2026 Diwali Festival Website</p>
    </footer>

</body>
</html>
/* General Styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background-color: #fff8e7;
    color: #4a1600;
}

/* Navigation */
header {
    background: #8b0000;
    padding: 18px;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

.navbar h2 {
    color: gold;
}

.navbar ul {
    display: flex;
    list-style: none;
    flex-wrap: wrap;
}

.navbar ul li {
    margin: 10px;
}

.navbar ul li a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

.navbar ul li a:hover {
    color: yellow;
}

/* Home Section */
.hero {
    min-height: 500px;
    background: linear-gradient(
        rgba(50, 0, 0, 0.5),
        rgba(50, 0, 0, 0.5)
    ),
    url("https://images.unsplash.com/photo-1606293926075-69a00dbfde81?w=1500");

    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    padding: 30px;
}

.hero h1 {
    color: gold;
    font-size: 55px;
    animation: glow 2s infinite alternate;
}

.hero h2 {
    font-size: 32px;
    margin: 15px;
}

.hero p {
    font-size: 18px;
    margin: 20px;
}

.btn {
    display: inline-block;
    background: gold;
    color: #8b0000;
    padding: 12px 25px;
    border-radius: 25px;
    text-decoration: none;
    font-weight: bold;
}

.btn:hover {
    background: white;
}

/* Common Sections */
.section {
    padding: 50px 8%;
    text-align: center;
}

.section h2 {
    color: #b22222;
    font-size: 32px;
    margin-bottom: 25px;
}

.section p {
    font-size: 17px;
    line-height: 1.8;
}

.section > img {
    width: 80%;
    max-height: 350px;
    object-fit: cover;
    border-radius: 15px;
    margin-top: 25px;
}

/* Celebration Cards */
.cards {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
}

.card {
    background: white;
    width: 280px;
    padding: 15px;
    border-radius: 15px;
    box-shadow: 0 4px 12px #d6a34a;
    transition: transform 0.3s;
}

.card:hover {
    transform: translateY(-10px);
}

.card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 10px;
}

.card h3 {
    color: #b22222;
    margin: 15px;
}

/* Gallery */
.gallery {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 25px;
}

.gallery img {
    width: 280px;
    height: 200px;
    object-fit: cover;
    border-radius: 15px;
    transition: transform 0.4s;
}

.gallery img:hover {
    transform: scale(1.08);
}

/* Audio and Video */
.media {
    background: #fff0c2;
}

.media h3 {
    margin: 20px;
    color: #8b0000;
}

audio {
    width: 80%;
    max-width: 400px;
}

video {
    max-width: 600px;
    border-radius: 15px;
    margin: 15px;
}

/* Safety Tips */
.safety {
    background: #fff1dc;
}

.safety ul {
    display: inline-block;
    text-align: left;
    line-height: 2.2;
    font-size: 17px;
}

/* Contact Form */
.contact {
    background: #ffe4b5;
}

form {
    max-width: 450px;
    margin: auto;
    display: flex;
    flex-direction: column;
    text-align: left;
}

form label {
    margin-top: 12px;
    font-weight: bold;
}

input, textarea {
    padding: 12px;
    margin-top: 8px;
    border: 1px solid #b22222;
    border-radius: 8px;
    font-size: 15px;
}

button {
    margin-top: 20px;
    padding: 12px;
    background: #8b0000;
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
}

button:hover {
    background: #d2691e;
}

/* Footer */
footer {
    background: #8b0000;
    color: white;
    text-align: center;
    padding: 25px;
}

footer h3 {
    color: gold;
    margin-bottom: 10px;
}

/* Animation */
@keyframes glow {
    from {
        text-shadow: 0 0 5px gold;
    }

    to {
        text-shadow: 0 0 25px orange,
                     0 0 40px gold;
    }
}

/* Mobile Responsive */
@media (max-width: 768px) {

    .navbar {
        flex-direction: column;
    }

    .navbar ul {
        justify-content: center;
    }

    .navbar ul li {
        margin: 8px;
    }

    .hero h1 {
        font-size: 38px;
    }

    .hero h2 {
        font-size: 25px;
    }

    .section {
        padding: 35px 5%;
    }

    .gallery img {
        width: 100%;
    }

    video {
        width: 100%;
        margin: 10px 0;
    }
}

